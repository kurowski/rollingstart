#!/usr/bin/env bash
# Check the open task.md for shape, never content: the list in
# docs/profile.md under "What rolling-check-profile and rolling-check-task
# check". task.md is the one place the model writes something the scripts
# run, so it is checked before anything reads it. Every fault on its own
# line. Exits 1 on any fault, 0 on none. Run as an action by the next
# skill right after writing the file.
set -u
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/common.sh
. "$here/../lib/common.sh"

top=$(rolling_toplevel) || { echo "not inside a git repository"; exit 2; }
learner=$(rolling_learner_dir "$top") || { echo "$rolling_no_data_msg"; exit 2; }
t="$learner/task.md"
[ -f "$t" ] || { echo "$t: does not exist (no open task)"; exit 1; }
mdir=$(rolling_map_dir "$top"); map="$mdir/map.md"
faults=0
fault() { echo "$1"; faults=$((faults + 1)); }

fm_has "$t" || { echo "$t: no frontmatter block"; exit 1; }
for k in $(fm_keys "$t"); do
  case $k in lesson|mode|branch|base|return-to|started|tutor-session|task|fix|scope|scaffold|setup|verify|held|held-verify|expect-fail-on-base) ;;
    *) fault "$t: unknown field '$k'" ;; esac
done
for k in lesson mode branch base return-to started tutor-session; do
  [ -n "$(fm_scalar "$t" "$k")" ] || fault "$t: $k is missing"
done
lesson=$(fm_scalar "$t" lesson)
if [ -n "$lesson" ]; then
  slug_ok "$lesson" || fault "$t: lesson '$lesson' is not a slug"
  [ -f "$mdir/lessons/$lesson.md" ] || fault "$t: lesson '$lesson' is not in the map"
fi
mode=$(fm_scalar "$t" mode); case $mode in ''|write|direct) ;; *) fault "$t: mode '$mode' is not write or direct" ;; esac
base=$(fm_scalar "$t" base); [ -z "$base" ] || hex_ok "$base" || fault "$t: base '$base' is not 7 to 40 hex characters"
rt=$(fm_scalar "$t" return-to)
if [ -n "$rt" ]; then
  ref=${rt%% *}; sha=${rt#* }
  if [ "$sha" = "$rt" ]; then hex_ok "$rt" || fault "$t: return-to '$rt' is neither '<ref> <sha>' nor a sha"
  else hex_ok "$sha" || fault "$t: return-to's second word '$sha' is not a sha"; git -C "$top" check-ref-format "refs/heads/$ref" 2>/dev/null || fault "$t: return-to's first word '$ref' is not a ref name"; fi
fi
st=$(fm_scalar "$t" started); [ -z "$st" ] || [[ $st =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fault "$t: started '$st' is not YYYY-MM-DD"
fx=$(fm_scalar "$t" fix); [ -z "$fx" ] || hex_ok "$fx" || fault "$t: fix '$fx' is not 7 to 40 hex characters"
tk=$(fm_scalar "$t" task)
if [ -n "$tk" ]; then
  slug_ok "$tk" || fault "$t: task '$tk' is not a slug"
  [ -z "$lesson" ] || [ -f "$mdir/lessons/$lesson/$tk.md" ] || fault "$t: task '$tk' is not a task of lesson '$lesson' ($mdir/lessons/$lesson/$tk.md does not exist)"
fi

scopes=$(fm_values "$t" scope)
[ -n "$scopes" ] || fault "$t: at least one scope: line is required"
while IFS= read -r s; do [ -z "$s" ] || relpath_ok "$s" || fault "$t: scope '$s' is not repository-relative"; done <<< "$scopes"
while IFS= read -r s; do
  [ -n "$s" ] || continue
  relpath_ok "$s" || { fault "$t: scaffold '$s' is not repository-relative"; continue; }
  inside=0
  while IFS= read -r sc; do
    [ -n "$sc" ] || continue
    pat=${sc%/}
    case $s in "$pat"|"$pat"/*) inside=1 ;; esac
    # shellcheck disable=SC2254  # the scope is a glob on purpose
    case $s in $pat) inside=1 ;; esac
  done <<< "$scopes"
  [ "$inside" -eq 1 ] || fault "$t: scaffold '$s' is not inside any scope"
done <<< "$(fm_values "$t" scaffold)"

verifies=$(fm_values "$t" verify); helds=$(fm_values "$t" held-verify)
[ -n "$verifies" ] || fault "$t: at least one verify: line is required"
for kind in verify held-verify; do
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key=${line%% *}; args=""; [ "$line" != "$key" ] && args=${line#* }
    if [ -f "$map" ]; then
      cmd=$(fm_map_get "$map" commands "$key")
      if [ -z "$cmd" ]; then fault "$t: $kind names '$key', which is not a command in the map"
      elif ! command_takes_args "$cmd"; then fault "$t: $kind names '$key', whose command in the map ends in an operator or contains '#'"; fi
    fi
    args_safe "$args" || fault "$t: $kind line '$line' carries a shell metacharacter, quote, or glob"
  done <<< "$(fm_values "$t" "$kind")"
done
while IFS= read -r op; do
  [ -n "$op" ] || continue
  if [ -f "$map" ]; then [ -n "$(fm_map_get "$map" operations "$op")" ] || fault "$t: setup names '$op', which is not an operation in the map"; fi
done <<< "$(fm_values "$t" setup)"
while IFS= read -r e; do
  [ -n "$e" ] || continue
  kind=${e%% *}; rest=${e#* }
  case $kind in
    verify) printf '%s\n' "$verifies" | grep -qxF -- "$rest" || fault "$t: expect-fail-on-base '$e' does not repeat a verify: line verbatim" ;;
    held-verify) printf '%s\n' "$helds" | grep -qxF -- "$rest" || fault "$t: expect-fail-on-base '$e' does not repeat a held-verify: line verbatim" ;;
    *) fault "$t: expect-fail-on-base '$e' must start with verify or held-verify" ;;
  esac
done <<< "$(fm_values "$t" expect-fail-on-base)"
seen_held=""
while IFS= read -r h; do
  [ -n "$h" ] || continue
  relpath_ok "$h" || { fault "$t: held '$h' is not a plain repository-relative path"; continue; }
  printf '%s\n' "$seen_held" | grep -qxF -- "$h" && fault "$t: held '$h' is listed twice"
  seen_held="$seen_held
$h"
  [ -f "$learner/held/$h" ] || fault "$t: held '$h' has no file under held/"
done <<< "$(fm_values "$t" held)"

case $mode in
  write)  body_has_h2 "$t" Brief || fault "$t: a write task needs a ## Brief heading" ;;
  direct) body_has_h2 "$t" Situation || fault "$t: a direct task needs a ## Situation heading" ;;
esac
body_has_h2 "$t" Source || fault "$t: no ## Source heading"

if [ "$faults" -eq 0 ]; then echo "task ok: $t"; exit 0; fi
echo "$faults fault(s) in $t"
exit 1

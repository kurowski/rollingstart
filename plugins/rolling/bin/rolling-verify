#!/usr/bin/env bash
# Run the open task's verifier and report, one line per command.
#
# The verifier is structured, never shell. Each verify: line in task.md
# names a command key declared under commands: in the map, optionally
# followed by arguments. The declared command line is run by a shell with
# the arguments appended as separate words (built as an array, never
# re-parsed); a key the map does not declare is reported, not run; a
# command that ends in a control operator, a redirection, or a backslash,
# or contains a `#`, is reported, not run, because the appended words
# would stop being arguments; arguments with a shell metacharacter, a
# glob, a quote, or a control character are rejected, because task.md is
# written by the model and its arguments must not become a way to run
# shell after all.
#
# Then the held test. Each held: path names a file in the learner
# directory's held/; for the held-verify: lines it is applied to the tree,
# with any learner file at the same path set aside, the lines run, and
# the file reverted and the learner's restored. The set-aside copy and a
# record of every step live in the learner's directory (held-aside/,
# held-aside.pending), so that a kill no trap can catch (SIGKILL, which
# is how the Bash tool ends a command past its timeout) leaves a record
# the next run finishes: every script that touches the tree calls
# held_finish_pending first. SIGINT and SIGTERM revert and stop. A step
# of the revert that fails keeps the record and says so in the report,
# and fails the proof; nothing of the learner's is deleted on a failure.
# The diff has already been captured by then (rolling-report runs
# rolling-diff first), so the held test is never in the diff.
#
#   rolling-verify            report PASS/FAIL per line
#   rolling-verify --on-base  the both-ways proof's first half: lines named
#                             by expect-fail-on-base: must fail, the rest
#                             must pass, every line must actually run, and
#                             the revert must succeed; PROOF: ok|not ok is
#                             the last line, on every exit
#
# Every command runs with stdin closed, from the repository root. Output
# ends with a VERIFIER: line. The exit status is always 0 once the report
# is printed: this runs inline, and a non-zero exit there aborts the
# skill, which is the opposite of what a failing verifier needs.
set -u
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/common.sh
. "$here/../lib/common.sh"

on_base=0
[ "${1:-}" = "--on-base" ] && on_base=1

# not_run WHY: the one way out before anything ran.
not_run() {
  echo "VERIFIER: not run ($1)"
  [ "$on_base" -eq 0 ] || echo "PROOF: not ok (the verifier did not run)"
  exit 0
}

top=$(rolling_toplevel) || not_run "not inside a git repository"
map="$(rolling_map_dir "$top")/map.md"
learner=$(rolling_learner_dir "$top") || not_run "$rolling_no_data_msg"
held_finish_pending "$learner" "$top" || not_run "a previous held-test revert could not be finished; see above"
task="$learner/task.md"
{ [ -f "$task" ] && fm_has "$task"; } || not_run "no open task"
{ [ -f "$map" ] && fm_has "$map"; } || not_run "no map: $map"

verify_lines=$(fm_values "$task" verify)
held_lines=$(fm_values "$task" held-verify)
held_paths=$(fm_values "$task" held)
expect_fail=$(fm_values "$task" expect-fail-on-base)
[ -n "$verify_lines" ] || [ -n "$held_lines" ] || not_run "the open task declares no verify: or held-verify: lines"

cd "$top" || not_run "cannot enter $top"
pass=0; fail=0; unknown=0; hpass=0; hfail=0; expected=0; proof_ok=1
expect_seen=""

# expected_to_fail KIND LINE: 0 if "KIND LINE" is an expect-fail-on-base entry.
expected_to_fail() {
  printf '%s\n' "$expect_fail" | grep -qxF -- "$1 $2"
}

# run_line KIND LINE: resolve, check, run, report. KIND is verify or held-verify.
# Anything that does not run counts against the proof: a proof is about
# lines that ran.
run_line() {
  local kind=$1 line=$2 key args cmd out rc label tag
  key=${line%% *}
  args=""; [ "$line" != "$key" ] && args=${line#* }
  label=$line
  tag=""; [ "$kind" = "held-verify" ] && tag="HELD "
  cmd=$(fm_map_get "$map" commands "$key")
  if [ -z "$cmd" ]; then
    echo "${tag}UNKNOWN  $label   (no command '$key' in the map)"; unknown=$((unknown + 1)); proof_ok=0; return
  fi
  if ! command_takes_args "$cmd"; then
    echo "${tag}REJECTED $label   (the map's command for '$key' ends in an operator or contains '#', so arguments cannot be appended safely)"; unknown=$((unknown + 1)); proof_ok=0; return
  fi
  if ! args_safe "$args"; then
    echo "${tag}REJECTED $label   (arguments may not contain shell metacharacters, quotes, globs, or control characters)"; unknown=$((unknown + 1)); proof_ok=0; return
  fi
  local -a words=()
  [ -n "$args" ] && split_words "$args" words
  out=$(bash -c "$cmd"' "$@"' verifier ${words[@]+"${words[@]}"} </dev/null 2>&1); rc=$?
  if [ "$on_base" -eq 1 ] && expected_to_fail "$kind" "$line"; then
    expect_seen="$expect_seen
$kind $line"
    if [ "$rc" -ne 0 ]; then echo "${tag}EXPECTED-FAIL($rc) $label   ($cmd)"; expected=$((expected + 1))
    else echo "${tag}UNEXPECTED-PASS $label   ($cmd)  <- must fail on the starting state"; proof_ok=0; fi
    return
  fi
  if [ "$rc" -eq 0 ]; then
    echo "${tag}PASS     $label   ($cmd)"
    if [ "$kind" = "verify" ]; then pass=$((pass + 1)); else hpass=$((hpass + 1)); fi
  else
    echo "${tag}FAIL($rc) $label   ($cmd)"
    if [ -n "$out" ]; then printf '%s\n' "$out" | tail -n 40 | sed 's/^/    | /'; else echo "    | (no output)"; fi
    if [ "$kind" = "verify" ]; then fail=$((fail + 1)); else hfail=$((hfail + 1)); fi
    proof_ok=0
  fi
}

revert_status=""
aside="$learner/held-aside"
marker="$learner/held-aside.pending"
# finish_held: end the held run through the one revert routine every
# script uses to recover from a killed one, so the normal path and the
# repair path cannot drift. Sets revert_status for the summary; a failed
# step fails the proof.
finish_held() {
  trap - EXIT INT TERM
  [ -f "$marker" ] || return 0
  local had=0; [ -s "$marker" ] && had=1
  if held_finish_pending "$learner" "$top" "${1:-}"; then
    if [ "$held_incomplete" -eq 1 ]; then revert_status="REVERT INCOMPLETE (a set-aside copy was missing; see above)"; proof_ok=0
    elif [ "$had" -eq 1 ]; then revert_status="reverted"; fi
  else
    revert_status="REVERT FAILED (record kept at $marker)"; proof_ok=0
  fi
}
# A signal the trap can catch reverts and stops; the loop must not go on
# running held lines against a tree the held test has left.
# shellcheck disable=SC2329  # invoked by the trap below
on_signal() {
  [ ! -s "$marker" ] || echo "HELD interrupted; reverting"
  finish_held   # not quiet: the learner is watching this one
  echo "VERIFIER: interrupted before the report was complete; run it again"
  [ "$on_base" -eq 0 ] || echo "PROOF: not ok (interrupted)"
  exit 0
}
trap 'finish_held quiet' EXIT
trap on_signal INT TERM

# --- the verify: lines, on the tree as the learner left it
if [ -n "$verify_lines" ]; then
  while IFS= read -r line; do run_line verify "$line"; done <<< "$verify_lines"
fi

# --- the held test: apply, run held-verify: lines, revert, restore
if [ -n "$held_lines" ] && [ -z "$held_paths" ]; then
  echo "HELD not run (held-verify: lines but no held: paths)"; proof_ok=0
fi
if [ -n "$held_lines" ] && [ -n "$held_paths" ]; then
  rm -rf "$aside"; mkdir -p "$aside"; : > "$marker"
  bad=0; seen_paths=""; applied_paths=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if ! relpath_ok "$p"; then echo "HELD REJECTED $p   (not a plain repository-relative path: no leading ./, no .., no //)"; bad=1; continue; fi
    if printf '%s\n' "$seen_paths" | grep -qxF -- "$p"; then echo "HELD REJECTED $p   (listed twice)"; bad=1; continue; fi
    seen_paths="$seen_paths
$p"
    if [ ! -f "$learner/held/$p" ]; then echo "HELD MISSING $p   (no copy under held/)"; bad=1; continue; fi
    if ! no_symlink_in "$top" "$p"; then echo "HELD REJECTED $p   (a symbolic link is in the way; the held test is applied only through plain files and directories)"; bad=1; continue; fi
    # Two spellings of one file (a case-folding filesystem, say) would
    # set aside the held copy just written as if it were the learner's.
    same=0
    for q in ${applied_paths[@]+"${applied_paths[@]}"}; do [ -e "$top/$p" ] && [ "$top/$p" -ef "$top/$q" ] && same=1; done
    if [ "$same" -eq 1 ]; then echo "HELD REJECTED $p   (the same file as another held path)"; bad=1; continue; fi
    if [ -e "$top/$p" ]; then
      # Copy in full to a temporary name, rename into place, record, then
      # remove the original: the record never names a partial copy.
      if ! { mkdir -p "$aside/$(dirname -- "$p")" 2>/dev/null && cp -R "$top/$p" "$aside/$p.rolling-tmp" 2>/dev/null && mv -f "$aside/$p.rolling-tmp" "$aside/$p" 2>/dev/null; }; then
        echo "HELD not applied: could not set aside your file at $p"; bad=1; break
      fi
      echo "aside $p" >> "$marker"
      rm -rf "${top:?}/$p" 2>/dev/null || { echo "HELD not applied: could not move your file at $p out of the way"; bad=1; break; }
    fi
    # Directories this apply creates are recorded innermost first, so the
    # revert can remove them in that order.
    d=$(dirname -- "$p"); chain=""
    while [ "$d" != "." ] && [ ! -d "$top/$d" ]; do chain="$chain$d
"; d=$(dirname -- "$d"); done
    [ -z "$chain" ] || printf '%s\n' "$chain" | while IFS= read -r cd_; do [ -n "$cd_" ] && echo "dir $cd_" >> "$marker"; done
    echo "applied $p" >> "$marker"
    if ! { mkdir -p "$(dirname -- "$top/$p")" 2>/dev/null && cp "$learner/held/$p" "$top/$p" 2>/dev/null; }; then
      echo "HELD not applied: could not copy the held file to $p"; bad=1; break
    fi
    applied_paths+=("$p")
  done <<< "$held_paths"
  if [ "$bad" -eq 0 ]; then
    while IFS= read -r line; do run_line held-verify "$line"; done <<< "$held_lines"
  else
    echo "HELD not run (a held path could not be applied; see above)"; proof_ok=0
  fi
fi
finish_held quiet

# An expect-fail-on-base entry that produced no result is a proof gap.
if [ "$on_base" -eq 1 ] && [ -n "$expect_fail" ]; then
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    printf '%s\n' "$expect_seen" | grep -qxF -- "$e" || { echo "PROOF GAP: expected to fail but never ran: $e"; proof_ok=0; }
  done <<< "$expect_fail"
fi

summary="VERIFIER: $pass passed, $fail failed, $unknown unknown or rejected"
[ "$on_base" -eq 1 ] && summary="$summary, expected failures: $expected"
[ -n "$held_lines" ] && summary="$summary; held: $hpass passed, $hfail failed${revert_status:+, $revert_status}"
echo "$summary"
if [ "$on_base" -eq 1 ]; then
  if [ "$proof_ok" -eq 1 ]; then echo "PROOF: ok (on the starting state, every expected failure failed, everything else passed, every line ran, and the held test was reverted)"
  else echo "PROOF: not ok (see UNEXPECTED-PASS, FAIL, UNKNOWN, REJECTED, REVERT FAILED, or PROOF GAP above; do not serve this task)"; fi
fi
exit 0

#!/usr/bin/env bash
# Put the repository into a task's starting state on a throwaway branch,
# committed, so the learner begins from a clean working tree and nothing
# about the answer sits in `git diff`, an editor gutter, or a stash.
#
#   rolling-begin-task <lesson> --fix <sha> [--held <path>]... [--shown <path>]...
#       The task is a real fix, reverted. Branch from the fix's parent.
#       --shown paths (its tests, when the lesson says test: shown) are
#       brought forward from the fix and committed, present and failing.
#       --held paths (the default, test: held) are copied from the fix
#       into the learner directory's held/ and never touch the tree; the
#       learner writes their own test and the held one runs at done. The
#       fix commit is not in the branch's history. A path may not be both.
#
#   rolling-begin-task <lesson> --here <path>...
#       The task starts from the current commit plus the files the tutor
#       has already put in the working tree (a new test, say), named
#       here. Branch here and commit those paths and only those; any
#       other change in the tree is the learner's and the script refuses
#       rather than sweep it into a commit they did not ask for. Files
#       only, so a directory cannot sweep either.
#
# Prints the lines task.md needs: branch:, base:, return-to: (a ref and
# its sha, or a sha alone), and one held: line per held path. Refuses,
# with a message and a non-zero exit: an open task (end or close it
# first), a dirty tree (in --fix mode, any change; in --here mode, any
# change outside the named paths), a root commit, a merge commit, a path
# the fix did not touch, a path both held and shown, and a lesson that is
# not a slug. A previous task's held/ is cleared before anything is
# written. Run as an action by the next skill, never inline, so a real
# status is right here.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/common.sh
. "$here/../lib/common.sh"

usage="usage: rolling-begin-task <lesson> --fix <sha> [--held <path>]... [--shown <path>]... | <lesson> --here <path>..."
lesson=${1:-}; mode=${2:-}
[ -n "$lesson" ] && [ -n "$mode" ] || { echo "$usage"; exit 2; }
shift 2
slug_ok "$lesson" || { echo "'$lesson' is not a lesson slug (lowercase kebab-case)"; exit 2; }

top=$(rolling_toplevel) || { echo "not inside a git repository"; exit 1; }
cd "$top"
git rev-parse --verify -q HEAD >/dev/null || { echo "the repository has no commits"; exit 1; }
learner=$(rolling_learner_dir "$top") || { echo "$rolling_no_data_msg"; exit 1; }
held_finish_pending "$learner" "$top" || { echo "a previous held-test revert could not be finished (see above); not starting a task"; exit 1; }
[ ! -f "$learner/task.md" ] || { echo "a task is already open ($(fm_scalar "$learner/task.md" lesson)); run rolling-end-task and rolling-close-task first"; exit 1; }

if ref=$(git symbolic-ref -q --short HEAD); then return_to="$ref $(git rev-parse HEAD)"
else return_to=$(git rev-parse HEAD); fi
stamp=$(date +%Y%m%d-%H%M%S)
branch="rolling/$lesson-$stamp"
git check-ref-format "refs/heads/$branch" || { echo "'$lesson' does not make a valid branch name"; exit 1; }
# Two tasks in one second (tests do this) get a numbered suffix.
n=1
while git show-ref --verify -q "refs/heads/$branch"; do n=$((n + 1)); branch="rolling/$lesson-$stamp-$n"; done

held=(); shown=()
case $mode in
  --fix)
    fix=${1:-}; [ -n "$fix" ] || { echo "--fix needs the fix commit's sha"; exit 2; }; shift
    while [ $# -gt 0 ]; do
      case $1 in
        --held)  [ -n "${2:-}" ] || { echo "--held needs a path"; exit 2; }; held+=("$2"); shift 2 ;;
        --shown) [ -n "${2:-}" ] || { echo "--shown needs a path"; exit 2; }; shown+=("$2"); shift 2 ;;
        *) echo "$usage"; exit 2 ;;
      esac
    done
    dirty=$(git status --porcelain)
    [ -z "$dirty" ] || { printf 'the working tree is not clean; commit, stash, or discard first:\n%s\n' "$dirty"; exit 1; }
    git cat-file -e "$fix^{commit}" 2>/dev/null || { echo "$fix is not a commit"; exit 1; }
    fix=$(git rev-parse "$fix^{commit}")
    git rev-parse -q --verify "$fix^" >/dev/null 2>&1 || { echo "$fix is a root commit; pick another fix"; exit 1; }
    ! git rev-parse -q --verify "$fix^2" >/dev/null 2>&1 || { echo "$fix is a merge commit; pick another fix"; exit 1; }
    for p in ${held[@]+"${held[@]}"} ${shown[@]+"${shown[@]}"}; do
      relpath_ok "$p" || { echo "$p is not a repository-relative path"; exit 1; }
      git diff --name-only "$fix^" "$fix" -- "$p" | grep -q . || { echo "$p is not changed by $fix; held and shown paths must be files the fix touched"; exit 1; }
      case $(git ls-tree "$fix" -- "$p" 2>/dev/null | awk '{ print $1; exit }') in
        100644|100755) ;;
        *) echo "$p is not a regular file at $fix (a directory, a symbolic link, or a file the fix deleted cannot be held or shown)"; exit 1 ;;
      esac
    done
    all_paths=""
    for p in ${held[@]+"${held[@]}"} ${shown[@]+"${shown[@]}"}; do
      printf '%s\n' "$all_paths" | grep -qxF -- "$p" && { echo "$p is listed twice"; exit 1; }
      all_paths="$all_paths
$p"
    done
    git switch -q -c "$branch" "$fix^"
    if [ ${#shown[@]} -gt 0 ]; then
      git checkout -q "$fix" -- "${shown[@]}"
    fi
    note=""
    [ ${#shown[@]} -eq 0 ] || note=", with that commit's test brought forward so it is present and failing"
    git commit -q --allow-empty -m "rolling: starting state for $lesson

The code as it was before $(git log -1 --format=%h "$fix")$note. A Rolling
Start task; the branch is throwaway."
    # The held copies, written only once the branch exists; a previous
    # task's copies go first, so nothing stale can be applied later.
    rm -rf "$learner/held"
    if [ ${#held[@]} -gt 0 ]; then
      mkdir -p "$learner/held"
      for p in "${held[@]}"; do
        mkdir -p "$learner/held/$(dirname -- "$p")"
        git show "$fix:$p" > "$learner/held/$p"
      done
    fi ;;
  --here)
    [ $# -ge 1 ] || { echo "--here needs the paths the task adds; $usage"; exit 2; }
    for p in "$@"; do
      relpath_ok "$p" || { echo "$p is not a plain repository-relative path (no leading ./, no .., no //)"; exit 1; }
      [ -f "$p" ] && [ ! -L "$p" ] || { echo "$p is not a regular file in the working tree (--here takes the files the task adds, one by one, never a directory or a link)"; exit 1; }
    done
    # Anything changed outside the named paths is the learner's; refuse.
    other=""
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      f=${line:3}; f=${f#\"}; f=${f%\"}
      mine=0
      for p in "$@"; do
        [ "$f" = "$p" ] && mine=1
      done
      [ "$mine" -eq 1 ] || other="$other$line
"
    done <<< "$(git -c core.quotePath=false status --porcelain -uall)"
    [ -z "$other" ] || { printf 'the working tree has changes outside the paths named; commit, stash, or discard them first:\n%s' "$other"; exit 1; }
    git switch -q -c "$branch"
    git add -- "$@"
    if git diff --cached --quiet; then
      echo "note: nothing to commit; the starting state is the current commit"
    else
      git commit -q -m "rolling: starting state for $lesson

The current commit plus the files the task adds. A Rolling Start task; the
branch is throwaway."
    fi
    rm -rf "$learner/held" ;;
  *) echo "$usage"; exit 2 ;;
esac

echo "branch: $branch"
echo "base: $(git rev-parse HEAD)"
echo "return-to: $return_to"
for p in ${held[@]+"${held[@]}"}; do echo "held: $p"; done

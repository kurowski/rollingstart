{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/rolling-session-start\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/rolling-guard\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ]
  }
}
